{
  "expo": {
    "name": "SakuLingo",
    "slug": "SakuLingo",
    "version": "1.0.0",
    "scheme": "sakulingo",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "updates": {
      "enabled": true
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
