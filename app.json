{
  "expo": {
    "icon": "./assets/icon.png",
    "owner": "longinuss",
    "label": "satulingo",
    "slug": "satulingo",
    "scheme": "com.satulingo.app",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "sdkVersion": "51.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.satulingo.app"
    },
    "android": {
      "package": "com.satulingo.app"
    },
    "extra": {
      "eas": {
        "projectId": "230cf64a-0c48-40f5-896c-47b88cc3900d"
      }
    }
  }
}
