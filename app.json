{
  "expo": {
    "icon": "./assets/icon.png",
    "owner": "longinuss",
    "name": "satulingo",
    "slug": "satulingo",
    "scheme": "com.satulingo.app",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "sdkVersion": "51.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": true
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.satulingo.app"
    },
    "android": {
      "package": "com.satulingo.app"
    }
  }
}
